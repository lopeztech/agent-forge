{
  "Comment": "Functional Tester role: triggered when an issue gets `state:awaiting-functional` (Test transitions here after pushing tests). Runs the Functional Fargate task with issue metadata. The agent clones the PR branch and posts a verification report.",
  "StartAt": "RunFunctional",
  "States": {
    "RunFunctional": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${functional_task_definition_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${jsonencode(subnets)},
            "SecurityGroups": ["${security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "functional",
              "Environment": [
                { "Name": "AGENT_FORGE_PRODUCT_ID", "Value.$": "$.detail.product_id" },
                { "Name": "AGENT_FORGE_ISSUE_NUMBER", "Value.$": "States.JsonToString($.detail.payload.issue.number)" },
                { "Name": "AGENT_FORGE_REPO", "Value.$": "$.detail.payload.repository.full_name" },
                { "Name": "AGENT_FORGE_DELIVERY_ID", "Value.$": "$.detail.delivery_id" },
                { "Name": "AGENT_FORGE_LABEL", "Value.$": "$.detail.payload.label.name" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "TaskFailed",
          "ResultPath": "$.error"
        }
      ],
      "End": true
    },
    "TaskFailed": {
      "Type": "Fail",
      "Cause": "Functional Fargate task failed; see log group for the task's container output."
    }
  }
}
