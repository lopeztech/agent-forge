{
  "Comment": "Dev role: triggered when an issue gets `state:ready`. Runs the Dev Fargate task with issue metadata as env vars. The agent itself acquires/releases area locks and transitions the label; this state machine only orchestrates the task lifecycle.",
  "StartAt": "RunDev",
  "States": {
    "RunDev": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${dev_task_definition_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${jsonencode(subnets)},
            "SecurityGroups": ["${security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "dev",
              "Environment": [
                { "Name": "AGENT_FORGE_PRODUCT_ID", "Value.$": "$.detail.product_id" },
                { "Name": "AGENT_FORGE_ISSUE_NUMBER", "Value.$": "States.JsonToString($.detail.payload.issue.number)" },
                { "Name": "AGENT_FORGE_REPO", "Value.$": "$.detail.payload.repository.full_name" },
                { "Name": "AGENT_FORGE_DELIVERY_ID", "Value.$": "$.detail.delivery_id" },
                { "Name": "AGENT_FORGE_LABEL", "Value.$": "$.detail.payload.label.name" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "TaskFailed",
          "ResultPath": "$.error"
        }
      ],
      "End": true
    },
    "TaskFailed": {
      "Type": "Fail",
      "Cause": "Dev Fargate task failed; see log group for the task's container output."
    }
  }
}
